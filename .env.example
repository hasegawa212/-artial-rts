# ── MARTIAL ARTS ONE 設定 ──
# 本番では AUTH_MODE=oidc・DATABASE_URL・https の APP_URL / OIDC_ISSUER が必須（満たさないと起動しない）。

# oidc（本番）| dev（ローカル開発用の仮ログイン。本番では起動拒否）
AUTH_MODE=dev
# 32 文字以上のランダム文字列: openssl rand -base64 48
SESSION_SECRET=
APP_URL=http://localhost:3100

# OIDC（Google Workspace / Microsoft Entra ID / Okta など。リダイレクトURI = ${APP_URL}/api/auth/callback）
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid email profile

# 空ならメモリ保存（開発のみ）。本番は PostgreSQL 必須。Netlify では自動の NETLIFY_DB_URL を使う。
DATABASE_URL=

# ロール付与（カンマ区切り、小文字化して比較）。ここに無い人はメンバー。
ADMIN_EMAILS=
MANAGER_EMAILS=
# 許可するメールドメイン（例: martialarts.co.jp）。本番の OIDC では必須（Google は誰のアカウントでも通すため）。
ALLOWED_EMAIL_DOMAINS=
# 個別に許可するアドレス（Gmail など、ドメインごと許可してはいけないもの）。カンマ区切り。
ALLOWED_EMAILS=
